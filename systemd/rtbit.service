[Unit]
Description=rtbit Bittorrent client
Documentation=https://github.com/TheDancingDeveloper-org/rustTorrent
After=rtbit.socket
Requires=rtbit.socket

[Service]
Type=simple
EnvironmentFile=-%E/rtbit/rtbit.conf
ExecStart=/usr/local/bin/rtbit server start %h/Downloads
Restart=on-failure
RestartSec=5
# Gives the shutdown path time to flush session persistence before SIGKILL.
TimeoutStopSec=30

# Hardening that a per-user service manager applies without mount or user
# namespaces. Filesystem sandboxing (ProtectSystem, PrivateTmp, ...) is left out
# on purpose: it needs namespaces that user units cannot always rely on.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
Also=rtbit.socket
