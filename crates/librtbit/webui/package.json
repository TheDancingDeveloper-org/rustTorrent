{
  "name": "rtbit-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --port 3032 --open /mock.html",
    "build": "tsc --noEmit && vite build && node post-build",
    "build:demo": "tsc --noEmit && RTBIT_DEMO_BUILD=1 vite build --base ./ --outDir ../../../website/demo --emptyOutDir && mv ../../../website/demo/mock.html ../../../website/demo/index.html && rm -rf ../../../website/demo/.vite ../../../website/demo/openapi.json",
    "test": "node --test src/helper/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@restart/ui": "^1.9.4",
    "lodash.debounce": "^4.0.8",
    "lodash.sortby": "^4.7",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.13",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.sortby": "^4.7.9",
    "@types/node": "^26.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
