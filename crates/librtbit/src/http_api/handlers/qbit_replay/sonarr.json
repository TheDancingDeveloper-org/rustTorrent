{
  "name": "sonarr",
  "client": "Sonarr v4 download-client proxy (QBittorrentProxyV2)",
  "notes": "Request order mirrors what Sonarr sends when testing the client, grabbing an episode, polling the queue and removing a completed download.",
  "steps": [
    { "name": "login", "live_only": true, "method": "POST", "path": "/auth/login",
      "form": { "username": "{{username}}", "password": "{{password}}" },
      "expect": { "status_in": [200, 204] }, "diff": { "body": "ignore" } },
    { "name": "version probe", "method": "GET", "path": "/app/webapiVersion",
      "expect": { "status": 200 }, "diff": { "body": "ignore" } },
    { "name": "app version", "method": "GET", "path": "/app/version",
      "expect": { "status": 200 }, "diff": { "body": "ignore" } },
    { "name": "client test reads preferences", "method": "GET", "path": "/app/preferences",
      "expect": { "status": 200, "json": [
        { "path": "save_path", "exists": true },
        { "path": "queueing_enabled", "exists": true },
        { "path": "max_ratio_enabled", "exists": true },
        { "path": "dht", "exists": true } ] },
      "diff": { "values": [] } },
    { "name": "list categories", "method": "GET", "path": "/torrents/categories",
      "expect": { "status": 200 }, "diff": { "body": "shape" } },
    { "name": "create sonarr category", "method": "POST", "path": "/torrents/createCategory",
      "form": { "category": "tv-sonarr", "savePath": "" },
      "expect": { "status": 200 } },
    { "name": "category visible", "method": "GET", "path": "/torrents/categories",
      "expect": { "status": 200, "json": [ { "path": "tv-sonarr.name", "eq": "tv-sonarr" } ] },
      "diff": { "values": ["tv-sonarr.name"] } },
    { "name": "grab episode (stopped, with category)", "method": "POST", "path": "/torrents/add",
      "multipart": { "torrent": true, "fields": {
        "category": "tv-sonarr", "stopped": "true", "paused": "true", "savepath": "{{save_path}}" } },
      "expect": { "status": 200 } },
    { "name": "queue poll by category", "method": "GET", "path": "/torrents/info",
      "query": { "category": "tv-sonarr" },
      "expect": { "status": 200, "eventually": true, "json": [
        { "path": "", "len": 1 },
        { "path": "0.hash", "eq": "cffa828a1727e7fdc662fd07329aedc10105a74a" },
        { "path": "0.name", "eq": "Replay.Show.S01E01.720p.mkv" },
        { "path": "0.category", "eq": "tv-sonarr" },
        { "path": "0.size", "eq": 32768 },
        { "path": "0.state", "one_of": ["stoppedDL", "pausedDL", "checkingResumeData"] },
        { "path": "0.save_path", "exists": true },
        { "path": "0.content_path", "exists": true },
        { "path": "0.ratio_limit", "exists": true },
        { "path": "0.seeding_time_limit", "exists": true } ] },
      "diff": { "values": ["0.hash", "0.name", "0.category", "0.size", "0.total_size", "0.progress"] } },
    { "name": "other categories stay empty", "method": "GET", "path": "/torrents/info",
      "query": { "category": "radarr" },
      "expect": { "status": 200, "json": [ { "path": "", "len": 0 } ] },
      "diff": { "values": [""] } },
    { "name": "apply seed goals", "method": "POST", "path": "/torrents/setShareLimits",
      "form": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a", "ratioLimit": "2", "seedingTimeLimit": "-2", "inactiveSeedingTimeLimit": "-2", "shareLimitAction": "Default" },
      "expect": { "status": 200 } },
    { "name": "seed goal visible", "method": "GET", "path": "/torrents/info",
      "query": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a" },
      "expect": { "status": 200, "json": [ { "path": "0.ratio_limit", "eq": 2 } ] },
      "diff": { "values": ["0.ratio_limit"] } },
    { "name": "top priority (409 when queueing is off is fine)", "method": "POST", "path": "/torrents/topPrio",
      "form": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a" },
      "expect": { "status_in": [200, 409] }, "diff": { "body": "ignore" } },
    { "name": "import reads properties", "method": "GET", "path": "/torrents/properties",
      "query": { "hash": "cffa828a1727e7fdc662fd07329aedc10105a74a" },
      "expect": { "status": 200, "json": [
        { "path": "save_path", "exists": true },
        { "path": "total_size", "eq": 32768 } ] },
      "diff": { "values": ["total_size", "piece_size", "pieces_num"] } },
    { "name": "import reads files", "method": "GET", "path": "/torrents/files",
      "query": { "hash": "cffa828a1727e7fdc662fd07329aedc10105a74a" },
      "expect": { "status": 200, "json": [
        { "path": "", "len": 1 },
        { "path": "0.name", "eq": "Replay.Show.S01E01.720p.mkv" },
        { "path": "0.size", "eq": 32768 } ] },
      "diff": { "values": ["0.name", "0.size", "0.priority"] } },
    { "name": "remove download", "method": "POST", "path": "/torrents/delete",
      "form": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a", "deleteFiles": "true" },
      "expect": { "status": 200 } },
    { "name": "queue empty after removal", "method": "GET", "path": "/torrents/info",
      "query": { "category": "tv-sonarr" },
      "expect": { "status": 200, "eventually": true, "json": [ { "path": "", "len": 0 } ] },
      "diff": { "values": [""] } },
    { "name": "drop category", "method": "POST", "path": "/torrents/removeCategories",
      "form": { "categories": "tv-sonarr" },
      "expect": { "status": 200 } }
  ]
}
