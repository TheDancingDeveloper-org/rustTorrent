{
  "name": "qbittorrent_api",
  "client": "qbittorrent-api (Python) common call sequence",
  "notes": "app_version, app_build_info, torrents_add, tags, start/stop, sync_maindata, transfer_info, torrents_delete.",
  "steps": [
    { "name": "login", "live_only": true, "method": "POST", "path": "/auth/login",
      "form": { "username": "{{username}}", "password": "{{password}}" },
      "expect": { "status_in": [200, 204] }, "diff": { "body": "ignore" } },
    { "name": "app_version", "method": "GET", "path": "/app/version",
      "expect": { "status": 200 }, "diff": { "body": "ignore" } },
    { "name": "app_web_api_version", "method": "GET", "path": "/app/webapiVersion",
      "expect": { "status": 200 }, "diff": { "body": "ignore" } },
    { "name": "app_build_info", "method": "GET", "path": "/app/buildInfo",
      "expect": { "status": 200, "json": [ { "path": "bitness", "exists": true } ] },
      "diff": { "values": [] } },
    { "name": "torrents_add", "method": "POST", "path": "/torrents/add",
      "multipart": { "torrent": true, "fields": { "stopped": "true", "paused": "true", "savepath": "{{save_path}}", "tags": "replay" } },
      "expect": { "status": 200 } },
    { "name": "torrents_info", "method": "GET", "path": "/torrents/info",
      "expect": { "status": 200, "eventually": true, "json": [
        { "path": "", "len": 1 },
        { "path": "0.hash", "eq": "cffa828a1727e7fdc662fd07329aedc10105a74a" },
        { "path": "0.tags", "eq": "replay" } ] },
      "diff": { "values": ["0.hash", "0.name", "0.tags", "0.size"] } },
    { "name": "torrents_add_tags", "method": "POST", "path": "/torrents/addTags",
      "form": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a", "tags": "second" },
      "expect": { "status": 200 } },
    { "name": "torrents_tags", "method": "GET", "path": "/torrents/tags",
      "expect": { "status": 200, "json": [ { "path": "", "contains": "second" }, { "path": "", "contains": "replay" } ] },
      "diff": { "body": "sorted" } },
    { "name": "torrents_info filter=stopped", "method": "GET", "path": "/torrents/info",
      "query": { "filter": "stopped" },
      "expect": { "status": 200, "eventually": true, "json": [ { "path": "", "len": 1 } ] },
      "diff": { "values": ["0.hash"] } },
    { "name": "torrents_set_category (unknown category)", "method": "POST", "path": "/torrents/setCategory",
      "form": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a", "category": "does-not-exist" },
      "expect": { "status": 409 }, "diff": { "body": "ignore" },
      "known_gap": { "status": 200, "note": "setCategory accepts a category that does not exist instead of answering 409 Incorrect category name" } },
    { "name": "sync_maindata full", "method": "GET", "path": "/sync/maindata",
      "query": { "rid": "0" },
      "expect": { "status": 200, "json": [
        { "path": "full_update", "eq": true },
        { "path": "rid", "exists": true },
        { "path": "torrents.cffa828a1727e7fdc662fd07329aedc10105a74a.name", "eq": "Replay.Show.S01E01.720p.mkv" },
        { "path": "server_state", "exists": true } ] },
      "diff": { "values": ["full_update", "torrents.cffa828a1727e7fdc662fd07329aedc10105a74a.name", "torrents.cffa828a1727e7fdc662fd07329aedc10105a74a.size"] } },
    { "name": "transfer_info", "method": "GET", "path": "/transfer/info",
      "expect": { "status": 200, "json": [ { "path": "connection_status", "exists": true } ] },
      "diff": { "values": [] } },
    { "name": "torrents_delete", "method": "POST", "path": "/torrents/delete",
      "form": { "hashes": "cffa828a1727e7fdc662fd07329aedc10105a74a", "deleteFiles": "true" },
      "expect": { "status": 200 } },
    { "name": "torrents_info empty", "method": "GET", "path": "/torrents/info",
      "expect": { "status": 200, "eventually": true, "json": [ { "path": "", "len": 0 } ] },
      "diff": { "values": [""] } },
    { "name": "torrents_delete_tags", "method": "POST", "path": "/torrents/deleteTags",
      "form": { "tags": "replay,second" },
      "expect": { "status": 200 } }
  ]
}
