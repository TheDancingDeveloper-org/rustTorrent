{
  "build": {
    "frontendDist": "../src"
  },
  "productName": "rtbit-desktop",
  "mainBinaryName": "rtbit-desktop",
  "identifier": "com.rtbit.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/TheDancingDeveloper-org/rustTorrent/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "mimeType": "application/x-bittorrent",
        "description": "Torrent File"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/rtbit-desktop.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/rtbit-desktop.desktop.hbs"
      }
    }
  }
}
